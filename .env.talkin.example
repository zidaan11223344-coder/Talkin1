# =========================================================
# Original Talkin bot from repository Talkin1
# Platform: https://console.altare.gg
# Copy this file to .env or add the variables in Altare.
# Never publish real passwords, cookies, or tokens in GitHub.
# =========================================================

# Talkin account credentials
BOT_ID=PUT_TALKIN_BOT_USERNAME_HERE
BOT_PWD=PUT_TALKIN_BOT_PASSWORD_HERE
BOT_PASSWORD=PUT_TALKIN_BOT_PASSWORD_HERE
BOT_USERNAME=PUT_TALKIN_BOT_USERNAME_HERE

# Master account
BOT_MASTER=PUT_MASTER_USERNAME_HERE
MASTER_USERNAME=PUT_MASTER_USERNAME_HERE
MASTER_ID=
MASTER_PWD=

# First room / automatic room joining
GROUP_TO_JOIN=PUT_ROOM_NAME_HERE
FIRST_ROOM=PUT_ROOM_NAME_HERE
AUTO_JOIN_ALL_ROOMS=1
AUTO_JOIN_ROOMS=1
JOIN_ALL_ROOMS=1

# Talkin network defaults
API_BASE_URL=https://chatp.net/api?
HOST_HEADER=chatp.net
WS_HOSTS=chatp.net
WS_PATHS=/server
REFERRER_URL=https://chatp.net/

# Altare public URL for generated images/audio
# Example: https://YOUR-SERVICE.altare.gg
PUBLIC_MEDIA_URL=https://YOUR-SERVICE.altare.gg
PUBLIC_BASE_URL=https://YOUR-SERVICE.altare.gg
GIFT_PUBLIC_BASE_URL=https://YOUR-SERVICE.altare.gg
RAILWAY_PUBLIC_DOMAIN=
RAVEN_PUBLIC_DOMAIN=

# Runtime/media server
PORT=8080
ASSET_HTTP_PORT=8080
ASSET_HTTP_ENABLED=1
BOT_ASSETS_DIR=/app/assets
BOT_DATA_DIR=/app/data
PERSISTENT_DATA_DIR=/app/data

# Game and media settings
BILLION_GAME_COOLDOWN_SECONDS=60
MILLION_GAME_COOLDOWN_SECONDS=60
MUSIC_MAX_SECONDS=900
MUSIC_COOLDOWN=15
TALKIN_TEXT_LIMIT=180
PRIVATE_AUDIO_TYPE=file

# Enable automatic room restore and normal operation
VERIFICATION_ENABLED=on
QUIET_MODE=1
LOG_ROOM_MESSAGES=0
CLEANUP_AUDIO_ENABLED=1
CLEANUP_CACHE_ENABLED=1
CLEANUP_TMP_ENABLED=1

# Optional YouTube cookies. Use only as a secret variable or mounted file.
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_FILE=
PIPED_APIS=

# Optional Spotify catalog credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional Telegram diagnostics
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SECRET_CHAT_ID=
TELEGRAM_LONG_TEXT_ENABLED=1

# Optional GitHub JSON state backup
GITHUB_SYNC=0
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_TOKEN=
