# Copy this file to .env for local development and replace every placeholder.
BOT_ID=your_bot_username
BOT_PWD=your_bot_password
BOT_MASTER=your_master_username
GROUP_TO_JOIN=your_room_name
# Netscape cookies text exported from a YouTube account; needed if YouTube asks for bot verification.
YOUTUBE_COOKIES=
PUBLIC_BASE_URL=
GIFT_PUBLIC_BASE_URL=
PIPED_APIS=
MUSIC_MAX_SECONDS=900
MUSIC_COOLDOWN=15

# Safe TalkinChat text packet size; list entries are sent one per message.
TALKIN_TEXT_LIMIT=180
# Private MP3 delivery as a downloadable file attachment.
PRIVATE_AUDIO_TYPE=file
# Experimental live-room flow used by: بث اسم الأغنية
STREAM_EXPERIMENTAL_ENABLED=1
STREAM_INVITE_ACTION=stream_invite
STREAM_ACCEPT_ACTION=stream_accept
STREAM_AUDIO_ACTION=stream_audio
STREAM_ACCEPT_STATE=accept
STREAM_ACCEPT_DELAY=0.8
STREAM_AUDIO_DELAY=0.8
# The official app sends the seat invitation. The bot listens for you_invited
# and sends the matching stream_accept packet automatically.
STREAM_MANUAL_ACCEPT_ONLY=1
# JSONL diagnostics for failed live-seat invitation acceptance.
STREAM_ERROR_LOG_FILE=data/stream_accept_errors.log
