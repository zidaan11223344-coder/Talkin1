BOT_USERNAME=
BOT_PASSWORD=
MASTER_USERNAME=
FIRST_ROOM=

# Keep the existing WebSocket session alive when the room is silent.
# These do NOT control reconnects; idle read timeouts never reconnect.
WS_IDLE_READ_TIMEOUT=5
WS_KEEPALIVE_INTERVAL=10

# Keep the same WebSocket connected when the room has no messages.
WS_IDLE_READ_TIMEOUT=5
WS_KEEPALIVE_INTERVAL=10

# مهم لصور الهدايا والأغاني: يجب أن يكون الدومين العام للخدمة مفعّلاً
PUBLIC_BASE_URL=
# ملف كوكيز يوتيوب (Netscape) لحل رسالة The page needs to be reloaded
YOUTUBE_COOKIES=
YOUTUBE_PLAYER_CLIENTS=tv,web_safari,mweb,web_embedded,default
YOUTUBE_ATTEMPTS=3
